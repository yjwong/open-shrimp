<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OpenShrimp</string>
	<key>CFBundleDisplayName</key>
	<string>OpenShrimp</string>
	<key>CFBundleIdentifier</key>
	<string>com.openshrimp.app</string>
	<key>CFBundleExecutable</key>
	<string>OpenShrimp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>icon</string>
	<!-- How the app launches and what it goes back to: no Dock icon and no menu
	     bar of its own, because the status item is the whole interface and an
	     app with no windows that took the Dock would offer a tile that opens
	     nothing.  The setup wizard promotes the app to a regular one for as long
	     as its window is up, so that window can be found again. -->
	<key>LSUIElement</key>
	<true/>
	<!-- SMAppService, which is how the login item is registered, exists from
	     13.0; below it there is no supported mechanism left to fall back to. -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Sparkle.  Stated here rather than set on the updater in code, which is
	     both what Sparkle's own documentation asks for and what lets the feed
	     be pointed somewhere else for a test build without touching Swift.

	     The feed URL is the `latest` redirect rather than a per-release one:
	     GitHub resolves it to the newest non-prerelease's asset of that name,
	     so the URL a shipped app carries forever does not have to name a tag
	     that did not exist when it was built. -->
	<key>SUFeedURL</key>
	<string>https://github.com/yjwong/open-shrimp/releases/latest/download/appcast.xml</string>
	<!-- The public half of the EdDSA pair the release workflow signs the
	     appcast with.  Sparkle installs nothing that does not verify against
	     it, so a feed served over a hijacked connection is inert.

	     Literal, not a build argument: it is not a secret, and a build that
	     was passed none would still build, still ship, and then silently
	     refuse every check.  Rotating it is a commit regardless — an install
	     carries its own copy and rejects whatever the new key signs. -->
	<key>SUPublicEDKey</key>
	<string>ScMHGKZGfRmQfhf0dYsKXSnzxW9lw9kzIrtUtr06xek=</string>
	<!-- Checked on a schedule and never on launch: the launch check is the
	     user-initiated path, which puts an "up to date" dialog on the screen
	     at every login.  Six hours matches what the core polls the releases
	     API at, so the two front ends notice a release at the same rate. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<!-- Downloaded and installed without asking, because the person who would
	     be asked is on Telegram rather than at this Mac.  A panel waiting for
	     a click is a machine that stops updating.  UpdateController takes the
	     install rather than letting it wait for a quit a menu bar app never
	     gets, and the core it seeds says which version it came back at.

	     The shipped default.  This and the scheduled check are re-applied at
	     every launch from the core's `auto_update`. -->
	<key>SUAutomaticallyUpdate</key>
	<true/>
</dict>
</plist>
