<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for the OpenShrimp tray app.

  Per-user, into LocalAppData, deliberately: the core binary self-updates by
  replacing itself in place, which a machine-wide install under Program Files
  would silently break for a non-elevated user.  It also means no UAC prompt to
  install, which is much of the point of shipping an installer at all.

  MSIX was the other candidate and was rejected: it installs to a versioned
  WindowsApps path that changes on every update, which would break the logon
  scheduled task the tray registers against a fixed exe path.

  Build with the WiX 7 toolset — -acceptEula is not optional there, the build
  fails WIX7015 without it, and that gate applies to `wix extension add` just
  as much as to `wix build`:
    wix extension add -g WixToolset.UI.wixext/7.0.0 -acceptEula wix7
    wix build -acceptEula wix7 -ext WixToolset.UI.wixext OpenShrimp.wxs \
      -arch x64 \
      -d ProductVersion=<x.y.z.0> \
      -d TrayPublishDir=<publish dir> \
      -d CoreExe=<path to openshrimp.exe> \
      -o OpenShrimp-<version>-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="OpenShrimp"
           Manufacturer="OpenShrimp"
           Version="$(ProductVersion)"
           UpgradeCode="6F3A9E42-6B0C-4C3E-9A2E-6B1B2D5C7A31"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenShrimp is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Id is the stream name Windows Installer extracts to; without a
         .ico suffix the shell cannot resolve an icon handler and both the
         shortcut and the Apps & Features entry fall back to a generic icon. -->
    <Icon Id="AppIcon.ico" SourceFile="$(TrayPublishDir)\Assets\tray.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OpenShrimp" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="OpenShrimp" />
    </StandardDirectory>

    <Feature Id="Main" Title="OpenShrimp" Level="1">
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentGroupRef Id="CoreFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!--
      Bring a running product to a stop before the transaction enumerates the
      files it is about to replace.  Without this an upgrade over a running
      tray does not complete at all: Restart Manager finds the tray and the
      core, offers to close them, reports success and is contradicted by MSI
      with 1611 — because closing a windowless app is something it can ask for
      and never enforce.  The dialog it fails into offers a retry that fails
      identically, so the only way past is to quit the tray from its own menu.

      Where this can go is not obvious.  A deferred action cannot do it: the
      execution script does not exist until InstallInitialize (1500), which is
      after the RemoveExistingProducts (1401) it would have to precede — which
      is also why the Util extension's CloseApplication is no use here.  It
      must run before InstallValidate (1400), because that is where the
      enumeration happens, and no earlier than CostFinalize (1000), which is
      where [INSTALLFOLDER] starts resolving.

      Return="ignore" rather than asyncNoWait: the action has to wait, both so
      that the product is gone before the enumeration and so that this errand's
      own process — which runs out of the directory being replaced — is not
      itself what Restart Manager then finds.  Ignore, because an upgrade must
      not stop over a product that was not running.

      Immediate, and therefore in the installing user's context, which is where
      the tray and its control endpoint live; a perUser package never elevates.
      Directory rather than FileRef for the same reason RemoveUserFootprint
      uses one: the file this names is one the transaction replaces.

      The FilesInUse and MsiRMFilesInUse dialogs below stay.  They stop being
      the path every upgrade takes and become the fallback for what this cannot
      reach — another user's session, or a tray too wedged to answer.
    -->
    <CustomAction Id="StopRunningApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]OpenShrimp.Tray.exe&quot; --stop"
                  Execute="immediate"
                  Return="ignore" />

    <!--
      Whether the installation being replaced has an errand to run at all.  The
      exe StopRunningApp invokes is the one already on disk, not this package's,
      and a tray that does not know the flag takes it for an ordinary launch —
      leaving the installer waiting, without a bound, on a tray it started
      itself.  That is worse than the failure it is there to prevent, so the
      errand runs only where the installation recorded that it has one.  The
      marker is written by the same component as the rest of this package's
      HKCU footprint and goes away with it.
    -->
    <Property Id="STOPERRAND">
      <RegistrySearch Id="StopErrandSearch" Root="HKCU" Key="Software\OpenShrimp"
                      Name="stop-errand" Type="raw" />
    </Property>

    <!--
      Unpack the core's runtime here rather than leaving every bit of it to the
      first launch.  The core is a self-installing binary: it carries an
      interpreter and a wheel, and the first command run against it spends
      minutes unpacking them and fetching dependencies.  The version probe
      below is the cheapest command that does that work, and a no-op once it
      is done.

      Return="ignore" is load-bearing.  The unpack needs the network, so a
      machine that is offline at install time must still get an installed
      product — the tray runs the same probe before it starts the core, so the
      only cost of failing here is that the first launch is slow again.

      Impersonate="yes" because the runtime lands in the invoking user's
      LocalAppData; a non-impersonated action would unpack it into the wrong
      profile and the user would pay for it twice.
    -->
    <CustomAction Id="WarmRuntime"
                  FileRef="CoreExecutable"
                  ExeCommand="--version"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!--
      Uninstall the two things this package installs without owning: the logon
      task the tray registers when the user asks for autostart, and the runtime
      WarmRuntime above unpacks.  Neither is a component — one is not a file at
      all, and the other lands under a distribution hash and a version nothing
      here can name.  Left behind, the first fires at every logon against a
      deleted exe and the second is hundreds of MB per installed version.

      The tray is asked rather than the core, because the core would unpack the
      runtime in order to be told to delete it; Uninstall.cs carries the whole
      argument.

      Directory rather than FileRef: this action's own binary is being removed
      by the transaction that runs it, and a deferred action referencing such a
      file resolves its path unreliably.  The command line is formatted when
      the execution script is written, which is why [INSTALLFOLDER] is readable
      here at all.

      Deferred and impersonated, matching WarmRuntime: both the runtime and the
      task belong to the invoking user, and the task in particular can only be
      deleted by the identity that registered it — the unelevated user the tray
      runs as.  Before RemoveFiles, while the exe still exists.
      Return="ignore" — an uninstall that cannot tidy up must still uninstall.

      NOT UPGRADINGPRODUCTCODE is load-bearing.  A major upgrade removes the
      old product from inside the new one's transaction with REMOVE=ALL set,
      so without the guard every upgrade would delete the runtime it is about
      to need and silently switch the user's autostart off.
    -->
    <CustomAction Id="RemoveUserFootprint"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]OpenShrimp.Tray.exe&quot; --uninstall"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- WIX_UPGRADE_DETECTED is what MajorUpgrade publishes, and covers the
           upgrade; Installed covers uninstall, which is blocked by the same
           files and needs the same errand.  A fresh install has neither, and
           nothing to stop. -->
      <Custom Action="StopRunningApp" After="CostFinalize"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND STOPERRAND" />
      <!-- After InstallFiles: the exe it runs does not exist before that. -->
      <Custom Action="WarmRuntime" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RemoveUserFootprint" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!--
      Start the tray from the finish page, so an install ends with the product
      running instead of with a Start Menu shortcut nobody was told about.

      The action launches the exe directly rather than through the Util
      extension's WixShellExec, which calls ShellExecuteW with a null parameter
      list and so cannot pass an argument at all.  The first-run flag is what
      lets the tray tell an installer launch from a logon one, and it has to
      survive.

      Immediate, and therefore always in the installing user's context: only a
      deferred action can run outside it, and a perUser package never elevates.
      That stays true only while nothing wraps this MSI in a bootstrapper
      manifested requireAdministrator — such a wrapper must be asInvoker.

      asyncNoWait because the installer has nothing left to do: the tray takes
      seconds to draw its first window and the exit dialog must not sit on it.
    -->
    <CustomAction Id="LaunchApplication"
                  FileRef="TrayExecutable"
                  ExeCommand="--first-run"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <!--
      A dialog set authored here rather than one of the five shipped ones,
      because the lightest of those (WixUI_Minimal) *is* a EULA page and no
      property suppresses it.  This product has no EULA to show and the tray
      owns onboarding, so the wizard is progress plus a finish page.

      It is this short because PrepareDlg, ProgressDlg and ExitDialog each
      schedule themselves from their own fragment; naming them is enough.
      WixUI_Common is not optional — it carries the bitmaps ExitDialog draws.

      Authored fresh rather than trimmed from a WiX 5-era set: WixUI has been
      custom-action-free since v6, and a copied set still references the
      deleted WixUIPrintEula.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch OpenShrimp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <!-- Removing a runtime is minutes of unpacked files going away, and a
           progress bar that names nothing is what makes it look hung.  The
           same goes for waiting out a core's shutdown, which unwinds a sandbox
           guest before it returns. -->
      <ProgressText Action="StopRunningApp" Message="Stopping OpenShrimp" />
      <ProgressText Action="RemoveUserFootprint" Message="Removing the OpenShrimp runtime" />

      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />

      <!--
        Order is unset on the launch and 999 on the end: an unordered Publish
        lands at 1, so the app starts before the dialog closes.  Raising it
        would end the dialog first and the launch would never run.

        The shipped checkbox is conditioned on NOT Installed and hidden
        otherwise, so a silent install (no dialog at all) and a repair both
        launch nothing without needing a UILevel guard.
      -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>

  <Fragment>
    <!--
      The whole self-contained publish output: app, .NET runtime, Windows App
      SDK.  The tray exe is carved out of the glob and given an explicit Id
      because Files invents one per harvested file, and the finish-page launch
      needs a name it can reference.
    -->
    <ComponentGroup Id="TrayFiles" Directory="INSTALLFOLDER">
      <Files Include="$(TrayPublishDir)\**">
        <Exclude Files="$(TrayPublishDir)\OpenShrimp.Tray.exe" />
      </Files>
      <Component>
        <File Id="TrayExecutable" Source="$(TrayPublishDir)\OpenShrimp.Tray.exe" />
      </Component>
    </ComponentGroup>

    <!--
      The PyApp core, installed beside the tray so CorePaths.CoreExecutable
      finds it without touching PATH.
    -->
    <ComponentGroup Id="CoreFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="CoreExecutable" Source="$(CoreExe)" Name="openshrimp.exe" />
      </Component>
    </ComponentGroup>

    <!--
      No autostart entry here on purpose: the tray owns that toggle so the menu
      always reflects reality, and an installer-created task would drift from it.
      Owning it is not the same as being able to leave it behind, which is what
      RemoveUserFootprint is for.
    -->
    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="TrayShortcut"
                  Name="OpenShrimp"
                  Description="Telegram bot for remote coding-agent access"
                  Target="[INSTALLFOLDER]OpenShrimp.Tray.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\OpenShrimp" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <!-- What STOPERRAND searches for: this installation's exe answers the
             stop flag, so the next transaction over it may use that instead of
             asking Restart Manager to close a window there is none of. -->
        <RegistryValue Root="HKCU" Key="Software\OpenShrimp" Name="stop-errand"
                       Type="integer" Value="1" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
