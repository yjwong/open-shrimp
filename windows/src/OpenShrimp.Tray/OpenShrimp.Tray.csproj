<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenShrimp.Tray</RootNamespace>
    <AssemblyName>OpenShrimp.Tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>

    <!--
      Unpackaged: the app installs per-user from an MSI to a stable path, so a
      logon scheduled task keeps pointing at the same exe across updates. An
      MSIX would land in a versioned WindowsApps folder and break that.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!--
      Self-contained on both axes so the MSI has no prerequisites at all — the
      thing that makes this a one-step install for a non-technical user.
    -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trimming breaks WinUI's XAML reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    Read the version from the repo's VERSION file, which is the single source
    of truth for it. Without this the assembly reports 1.0.0.0 forever (visible
    in Explorer's details pane and in crash reports) and cutting a release
    would silently not move it.
  -->
  <PropertyGroup>
    <_VersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\VERSION'))</_VersionFile>
    <VersionPrefix Condition="'$(VersionPrefix)' == '' And Exists('$(_VersionFile)')"
    >$([System.IO.File]::ReadAllText('$(_VersionFile)').Trim())</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <!-- WinUI 3 ships no tray-icon API of its own. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Every compiled XAML page lives inside the project's .pri, and publish leaves
    it behind: the target that adds it to the publish set ships in the MSIX
    tooling's targets, which are not imported here. MrtCore still generates the
    file into the build output, so it only needs carrying across.

    Without this the app launches — a tray icon and a native Win32 menu need no
    XAML page — and then throws XamlParseException the first time it opens a
    window, which is the wizard, on a machine that has no config yet.
  -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             RelativePath="$(ProjectPriFileName)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    The failure this guards against is invisible in a build log and only shows
    up as a crash on a user's machine, so it is worth failing the build over.
    An unset ProjectPriFileName is its own failure, and is called out rather
    than left to resolve into a test of whether the publish directory exists.
  -->
  <Target Name="VerifyPublishedPriFile" AfterTargets="Publish">
    <Error Condition="'$(ProjectPriFileName)' == '' or !Exists('$(PublishDir)$(ProjectPriFileName)')"
           Text="The project's .pri file is missing from $(PublishDir) — the published app carries no compiled XAML and every window it opens will fail to load." />
  </Target>

</Project>
