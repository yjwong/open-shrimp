<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenShrimp.Tray.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Set up OpenShrimp">

    <!-- No Background: an opaque brush anywhere above the content hides Mica. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Padding is set in code-behind from the caption-button inset. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="16" Height="16"
                   Source="ms-appx:///Assets/tray.ico"
                   VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Set up OpenShrimp"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="32,12,32,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="StepSubtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Steps -->
            <Grid Grid.Row="1">

                <!-- Step 0: bot token -->
                <StackPanel x:Name="StepToken" Spacing="10" Visibility="Visible">
                    <PasswordBox x:Name="TokenBox"
                                 Header="Telegram bot token"
                                 PlaceholderText="123456:ABC-DEF…"
                                 PasswordRevealMode="Peek" />
                    <HyperlinkButton Content="Open @BotFather in Telegram →" Click="OpenBotFather" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="TokenSpinner" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="TokenMessage" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Step 1: enrollment.  The code travels phone to desktop,
                    which is the only direction that works when the wizard is
                    here and Telegram is only on a phone.
                -->
                <StackPanel x:Name="StepEnroll" Spacing="10" Visibility="Collapsed">

                    <StackPanel x:Name="EnrollWaiting" Spacing="10">
                        <TextBlock x:Name="EnrollInstruction" TextWrapping="Wrap"
                                   Text="Open Telegram, search for your bot, and press START." />
                        <HyperlinkButton x:Name="DeepLinkButton"
                                         Content="Already have Telegram on this PC? Open it here →"
                                         Visibility="Collapsed"
                                         Click="OpenDeepLink" />
                        <TextBox x:Name="SetupCodeBox"
                                 Header="Setup code"
                                 PlaceholderText="000 000"
                                 Width="160"
                                 HorizontalAlignment="Left"
                                 KeyDown="SetupCodeKeyDown" />
                        <HyperlinkButton Content="Paste a user ID instead" Click="ChooseManualEntry" />
                    </StackPanel>

                    <!-- Names the consequence, not only the person. -->
                    <StackPanel x:Name="EnrollConfirming" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Name="CandidateLabel" TextWrapping="Wrap"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Adding them lets them read and change files on this computer." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConfirmButton" Content="Yes, that's me"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ConfirmCandidate" />
                            <Button x:Name="DeclineButton" Content="Not me" Click="DeclineCandidate" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="EnrollManual" Spacing="10" Visibility="Collapsed">
                        <TextBox x:Name="UserIdBox"
                                 Header="Your Telegram user ID"
                                 PlaceholderText="123456789" />
                        <HyperlinkButton Content="Open @userinfobot in Telegram →" Click="OpenUserInfoBot" />
                        <!-- A network blip must not be a one-way door into
                             typing a number from memory. -->
                        <HyperlinkButton Content="Use a setup code instead" Click="RestartEnrollment" />
                    </StackPanel>

                    <TextBlock x:Name="EnrollMessage" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Step 2: first context -->
                <StackPanel x:Name="StepContext" Spacing="10" Visibility="Collapsed">
                    <TextBox x:Name="ContextNameBox" Header="Context name" Text="default" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Working directory" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DirectoryLabel"
                                       Text="No folder chosen"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Width="280" />
                            <Button Content="Choose…" Click="ChooseFolder" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox x:Name="ModelBox" Header="Model" Width="320" />
                    <TextBlock x:Name="ContextMessage" TextWrapping="Wrap" />
                </StackPanel>

                <!--
                    Step 3: autostart.  A step of its own rather than a fourth
                    field on the context form, because it asks about the app and
                    not about the context.  Ticked by default, with the
                    consequence in words rather than a bare label.
                -->
                <StackPanel x:Name="StepFinish" Spacing="10" Visibility="Collapsed">
                    <StackPanel Spacing="2">
                        <CheckBox x:Name="AutostartBox"
                                  Content="Keep OpenShrimp running after you sign in"
                                  IsChecked="True" />
                        <!-- Indented to the checkbox's label, not to its box. -->
                        <TextBlock Text="Without this, OpenShrimp stops when you quit the app or sign out."
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer: progress dots + navigation -->
            <Grid Grid.Row="2">
                <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Click="GoBack" />
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="GoNext" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
