<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The LinkedIn handover bubble, which has to float over another app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- largeHeap: diarization holds an entire meeting as float PCM in memory. -->
    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenShrimp Companion"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Answering an agent question, opened from its notification. Its own
          task with no affinity to the main one, so answering from over another
          app does not drag the companion's back stack in with it.
        -->
        <activity
            android:name=".QuestionSheetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/SheetTheme" />

        <service
            android:name=".SecurityKeyForwardingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".PortForwardProxyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".MeetingRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".MeetingDiarizationService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />

        <!-- Bound into a uid-0 process by libsu, not started by the system. -->
        <service
            android:name=".WhatsAppReaderService"
            android:exported="false" />

        <!-- The same, for the one query a LinkedIn handover runs. -->
        <service
            android:name=".LinkedInReaderService"
            android:exported="false" />

        <!--
          Foreground because it holds Binder calls into the root process open
          for seconds at a time, and the system kills a cached process that
          does rather than waiting for it.
        -->
        <!--
          specialUse, not dataSync: dataSync is capped at six cumulative
          background hours per day across every dataSync service in the app,
          and this one is meant to be resident. Exceeding the cap stops it
          silently until the app is next opened, and it would spend the same
          budget the forwarding and port-forward services need.
        -->
        <service
            android:name=".WhatsAppWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Reads new WhatsApp messages from the selected chats and forwards them to the paired OpenShrimp host" />
        </service>

        <!--
          Bound by the system once the user turns it on in Accessibility
          settings; there is no way for the app to start it. The permission
          below is what makes the system the only thing that may bind it.
        -->
        <service
            android:name=".LinkedInAccessibilityService"
            android:exported="false"
            android:label="@string/linkedin_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/linkedin_accessibility_service" />
        </service>

        <service
            android:name=".ShrimpFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".AgentApprovalReceiver"
            android:exported="false" />

        <receiver
            android:name=".AgentQuestionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
